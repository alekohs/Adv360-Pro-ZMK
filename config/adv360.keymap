#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"

        rpi: require_prior_idle {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <1>;
            bindings = <&kp>, <&kp>;
        };

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
      meh_key: meh_key {
          compatible = "zmk,behavior-macro";
          #binding-cells = <0>;
          bindings = <&macro_press &kp LSHIFT &kp LCTRL &kp LALT>,
                      <&macro_pause_for_release>,
                      <&macro_release &kp LSHIFT &kp LCTRL &kp LALT>;
      };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1     &kp N2     &kp N3    &kp N4     &kp N5  &tog 1                                                       &mo 3              &kp N6  &kp N7    &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W      &kp E     &kp R      &kp T   &none                                                        &mo 4              &kp Y   &kp U     &kp I      &kp O     &kp P     &kp BSLH
&kp LCTRL  &kp A      &kp S      &kp D     &kp F      &kp G   &none      &kp HOME  &kp END       &kp LC(LA(LGUI(KC_NO))) &kp PAGE_DOWN  &kp LC(LA(SPACE))  &kp H   &kp J     &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X      &kp C     &kp V      &kp B                        &kp LALT      &kp RALT                                     &kp N   &kp M     &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 2      &kp GRAVE  &kp LCTRL  &kp LEFT  &kp RIGHT          &kp SPACE  &kp BSPC  &kp LGUI      &kp RGUI   &kp DEL        &kp ENTER                  &kp DOWN  &kp UP     &kp LBKT  &kp RBKT  &kp ESC
            >;
        };

        clean {
            display-name = "Rpi";
            bindings = <
&trans  &trans        &trans       &trans       &trans         &trans  &trans                                      &trans  &trans  &trans         &trans       &trans       &trans           &trans
&trans  &trans        &trans       &trans       &trans         &trans  &trans                                      &trans  &trans  &trans         &trans       &trans       &trans           &trans
&trans  &rpi LCTRL A  &rpi LALT S  &rpi LGUI D  &rpi LSHIFT F  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &rpi RSHIFT J  &rpi RGUI K  &rpi RALT L  &rpi RCTRL SEMI  &trans
&trans  &trans        &trans       &trans       &trans         &trans                  &trans      &trans                  &trans  &trans         &trans       &trans       &trans           &trans
&trans  &trans        &trans       &trans       &trans                 &trans  &trans  &trans      &trans  &trans  &trans          &trans         &trans       &trans       &trans           &trans
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        macos {
            display-name = "Red";
            bindings = <
&none  &none             &none             &kp LG(LS(N3))     &kp LG(LS(N4))  &none  &none                                  &none  &none  &none  &none  &none  &none  &none
&none  &kp LC(LA(E))     &kp LA(LC(UP))    &kp LC(LA(T))      &none           &none  &none                                  &none  &none  &none  &none  &none  &none  &none
&none  &kp LC(LA(LEFT))  &kp LA(LC(DOWN))  &kp LA(LC(RIGHT))  &none           &none  &none  &none  &none      &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &kp LC(LA(L))     &kp LA(LC(BSLH))  &kp LA(LC(SQT))    &none           &none                &none      &none                &none  &none  &none  &none  &none  &none
&none  &none             &none             &none              &none                  &none  &none  &none      &none  &none  &none         &none  &none  &none  &none  &none
            >;
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
